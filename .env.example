# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (MySQL 8.4)
MYSQL_ROOT_PASSWORD=mococall_root_password
MYSQL_DATABASE=mococall
MYSQL_USER=mococall_user
MYSQL_PASSWORD=mococall_dev_password
DATABASE_URL=mysql://mococall_user:mococall_dev_password@localhost:3306/mococall

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters_long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Telephony (disabled by default - runs deterministic mock calling)
TELEPHONY_ENABLED=false
TELEPHONY_MODE=mock
TELEPHONY_COMPLIANCE_VERIFIED=false
TELEPHONY_WEBHOOK_SECRET=change_me_telephony_webhook_secret
PUBLIC_API_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
SIP_PROVIDER_HOST=
SIP_PROVIDER_PORT=5060
SIP_PROVIDER_USERNAME=
SIP_PROVIDER_PASSWORD=

# Operational Limits & Abuse Prevention Defaults
DEFAULT_MAX_CALL_DURATION_SECONDS=1800
DEFAULT_DAILY_CALL_LIMIT=50
DEFAULT_MONTHLY_CALL_QUOTA=500
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_CALLS=5

# Web Client
VITE_API_BASE_URL=http://localhost:4000/api/v1
