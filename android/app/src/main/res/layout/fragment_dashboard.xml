<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Operations Dashboard"
                android:textColor="@color/mc_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTelephonyBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/mc_surface_alt"
                android:padding="12dp"
                android:text="@string/telephony_mock_banner"
                android:textColor="@color/mc_info"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/mc_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTotalCalls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Calls: 0"
                    android:textColor="@color/mc_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompletedCalls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Completed: 0"
                    android:textColor="@color/mc_success"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFailedCalls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Failed: 0"
                    android:textColor="@color/mc_danger"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTotalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Total Duration: 00:00"
                    android:textColor="@color/mc_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAvgDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Average Duration: 00:00"
                    android:textColor="@color/mc_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/mc_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvDailyQuota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Calls: 0 / 50"
                    android:textColor="@color/mc_text"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/progressDailyQuota"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvMonthlyQuota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Monthly Quota: 0 / 500"
                    android:textColor="@color/mc_text"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/progressMonthlyQuota"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenDialer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Open Call Dialer" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
